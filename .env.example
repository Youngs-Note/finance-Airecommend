APP_NAME=finance-Airecommend API
APP_ENV=development
APP_DATA_MODE=sample

# Finlife API: required only when APP_DATA_MODE=finlife
FINLIFE_API_KEY=
FINLIFE_BASE_URL=https://finlife.fss.or.kr/finlifeapi
FINLIFE_BANK_GROUP_CODE=020000
FINLIFE_ALLOWED_BANKS=국민은행,KB국민은행,신한은행,우리은행,하나은행,주식회사 하나은행,한국스탠다드차타드은행,SC제일은행,한국씨티은행,주식회사 케이뱅크,케이뱅크,주식회사 카카오뱅크,카카오뱅크,토스뱅크 주식회사,토스뱅크
FINLIFE_TIMEOUT_SECONDS=10
FINLIFE_CACHE_TTL_SECONDS=21600

# OpenAI API: optional until the explanation feature is enabled
OPENAI_EXPLANATIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=15

# Neon(PostgreSQL): reserved for allowed app data only
# Neon 콘솔 > Connect 에서 복사한 접속 문자열을 넣는다.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/finance_ai?sslmode=require&channel_binding=require
